# ─────────────────────────────────────────────
# CHISA AI — Environment Configuration Template
# Copy to .env and fill in all values
# ─────────────────────────────────────────────

# ── Application ────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_DEBUG=true
SECRET_KEY=change_this_to_a_strong_random_secret

# ── PostgreSQL ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://chisa:chisa_secret@localhost:5432/chisa_db

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Qdrant ─────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_EMBEDDING_DIM=384

# ── LLM Provider Selection ─────────────────────
LLM_PROVIDER=deepseek # Switch to 'gemini' | 'groq' | 'deepseek'

# ── LLM ── DeepSeek ────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_TIMEOUT=60
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── LLM ── Groq ────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.8
GROQ_TIMEOUT=30

# ── LLM ── Gemini ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.8
GEMINI_TIMEOUT=30

# ── Embeddings ─────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Search API Keys ────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=
ENABLE_PAID_SEARCH=false

# ── JWT ────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── Rate Limiting ──────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Celery / Workers ───────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WORKER_CONCURRENCY=4
