# ─────────────────────────────────────────────
# CHISA AI — Environment Configuration Template
# Copy to .env and fill in all values
# ─────────────────────────────────────────────

# ── Application ────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
WEB_CONCURRENCY=2 # Your server CPU Cores
APP_DEBUG=true
SECRET_KEY=change_this_to_a_strong_random_secret

# ── PostgreSQL ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://chisa:replace_with_unique_database_password@localhost:5432/chisa_db
# Docker Compose production reads these files as Docker secrets; do not commit them.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
REDIS_PASSWORD_FILE=./secrets/redis_password
DISCORD_DATABASE_URL=postgresql://chisa:replace_with_unique_database_password@postgres:5432/chisa_db

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_USERNAME=chisa

# ── Qdrant ─────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Supplied by the deployment secret manager in production; never commit its value.
QDRANT_API_KEY=replace_with_qdrant_api_key
# Must match the active corpus/index version. Changing it requires a new corpus
# version, full re-embedding, golden-set evaluation, and an atomic alias swap.
QDRANT_EMBEDDING_DIM=384

# Canonical ingestion sources are restricted to these HTTPS hostnames.
INGESTION_ALLOWED_SOURCE_HOSTS=wutheringwaves.fandom.com

# ── LLM Provider Selection ─────────────────────
LLM_PROVIDER=deepseek # Switch to 'gemini' | 'groq' | 'deepseek'

# ── LLM ── DeepSeek ────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_TIMEOUT=60
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEP_THINKING=true # Switch to 'true' | 'false' to turn on/off reasoning

# ── LLM ── Groq ────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.8
GROQ_TIMEOUT=30

# ── LLM ── Gemini ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.8
GEMINI_TIMEOUT=30

# ── Embeddings ─────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# API reranking is the P1 default when an approved provider secret is provisioned.
# Only redacted, public/approved lore may cross this provider boundary.
RERANKER_PROVIDER=voyage
RERANKER_API_MODEL=rerank-3-lite
RERANKER_API_MAX_DOCUMENTS=15
# Supply only through a secret manager or an untracked .env file; never commit it.
VOYAGE_API_KEY=replace_with_voyage_api_key
# Approved next benchmark candidate (do not enable without user-provisioned
# token capacity): RERANKER_PROVIDER=jina and
# RERANKER_API_MODEL=jina-reranker-v3.5. Keep auto top-up disabled unless the
# user/project owner separately approves it.
JINA_API_KEY=
# Other benchmark alternative; leave blank unless explicitly selected.
COHERE_API_KEY=
# Leave unset until the model artifact and its license have been approved and
# provisioned in the deployment cache. Request-time downloads are disabled.
RERANKER_MODEL=
RERANKER_TIMEOUT_SECONDS=1.5
RERANKER_BATCH_SIZE=16

# ── Search API Keys ────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=
ENABLE_PAID_SEARCH=false

# ── JWT ────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=kuchiba-chisa
JWT_AUDIENCE=kuchiba-chisa-api
# Separate from JWT_SECRET. Shared only by Core API and the Discord workload adapter.
DISCORD_WORKLOAD_JWT_SECRET=replace_with_a_distinct_32_character_workload_secret
DISCORD_WORKLOAD_JWT_ISSUER=kuchiba-chisa-discord

# ── Rate Limiting ──────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOCAL_FALLBACK_MAX_KEYS=10000
RATE_LIMIT_IP_ANOMALY_PER_MINUTE=120
# Pre-auth session issuance is limited by a trusted client IP, never X-User-ID.
ANONYMOUS_SESSION_RATE_LIMIT_PER_MINUTE=10
# Comma-separated reverse-proxy CIDRs. Leave empty unless the peer is a managed proxy.
TRUSTED_PROXY_CIDRS=

# Request admission (SEC-05): limits apply before image decoding/fetching.
CHAT_MAX_MESSAGE_CHARS=4000
COMMUNITY_MAX_HISTORY_MESSAGES=20
COMMUNITY_MAX_MESSAGE_CHARS=4000
COMMUNITY_MAX_REPLY_CONTEXT_CHARS=1000
COMMUNITY_MAX_IDENTIFIER_CHARS=128
COMMUNITY_MAX_TIMESTAMP_CHARS=64
VISION_MAX_IMAGES=4
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_IMAGE_URL_CHARS=2048
VISION_MAX_TOTAL_DECODED_BYTES=41943040
API_MAX_REQUEST_BODY_BYTES=62914560
LLM_OUTPUT_MAX_RESPONSE_CHARS=16000

# Metadata-only pipeline trace retention in Redis (one hour by default).
PIPELINE_TRACE_TTL_SECONDS=3600

# ── Celery / Workers ───────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# The single VPS profile runs ingestion sequentially, preferably off-peak.
WORKER_CONCURRENCY=1
