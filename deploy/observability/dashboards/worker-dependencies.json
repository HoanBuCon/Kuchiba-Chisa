          "refId": "A"
        }
      ],
      "title": "Dependency availability",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, chisa_dependency) (rate(chisa_dependency_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{chisa_dependency}}",
          "refId": "A"
        }
      ],
      "title": "Dependency check latency p95",
      "type": "timeseries"
    }
