      "id": 3,
      "targets": [
        {
          "expr": "sum by (chisa_job_type) (chisa_worker_active)",
          "legendFormat": "{{chisa_job_type}}",
          "refId": "A"
        }
      ],
      "title": "Active worker jobs",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (chisa_job_type, chisa_status) (rate(chisa_worker_jobs_total[$__rate_interval]))",
          "legendFormat": "{{chisa_job_type}} {{chisa_status}}",
          "refId": "A"
        }
      ],
      "title": "Job completion outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, chisa_job_type) (rate(chisa_worker_job_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{chisa_job_type}}",
          "refId": "A"
        }
      ],
      "title": "Job processing duration p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (chisa_job_type, chisa_failure_class) (rate(chisa_worker_retries_total[$__rate_interval]))",
          "legendFormat": "retry {{chisa_job_type}} {{chisa_failure_class}}",
          "refId": "A"
        },
        {
          "expr": "sum by (chisa_job_type, chisa_failure_class) (rate(chisa_worker_failures_total[$__rate_interval]))",
          "legendFormat": "failure {{chisa_job_type}} {{chisa_failure_class}}",
          "refId": "B"
        },
        {
          "expr": "sum by (chisa_job_type) (increase(chisa_worker_dlq_total[$__rate_interval]))",
          "legendFormat": "DLQ {{chisa_job_type}}",
          "refId": "C"
        },
        {
          "expr": "sum by (chisa_job_type, chisa_status) (increase(chisa_worker_replays_total[$__rate_interval]))",
          "legendFormat": "replay {{chisa_job_type}} {{chisa_status}}",
          "refId": "D"
        }
      ],
      "title": "Retry, failure, DLQ and replay",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "bool"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 7,
      "targets": [
        {
          "expr": "min by (chisa_dependency) (chisa_dependency_available)",
