{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG-05 Public Lore Golden Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "evidence_scope", "approval", "cases"],
  "properties": {
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence_scope": {"const": "public"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": {"enum": ["draft", "approved"]},
        "approved_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "query", "expected_behavior", "relevant_evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "category": {"type": "string", "minLength": 1, "maxLength": 64},
          "query": {"type": "string", "minLength": 1, "maxLength": 4000},
          "expected_behavior": {"enum": ["retrieve", "abstain"]},
          "expected_answer_excerpt": {"type": "string", "minLength": 1, "maxLength": 2000},
          "relevant_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^raw_wiki:[0-9]+:[0-9]+:[0-9a-f]{16}:chunk:[0-9]{3}$"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"expected_behavior": {"const": "retrieve"}}},
            "then": {
              "required": ["expected_answer_excerpt"],
              "properties": {"relevant_evidence_ids": {"minItems": 1}}
            }
          },
          {
            "if": {"properties": {"expected_behavior": {"const": "abstain"}}},
            "then": {"properties": {"relevant_evidence_ids": {"maxItems": 0}}}
          }
        ]
      }
    }
  }
}
