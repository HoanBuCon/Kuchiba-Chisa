# Discord bot
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_dev_guild_id

# PostgreSQL for the bot service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chisa_discord
DATABASE_SSL=false

# Core RAG backend
CORE_RAG_BASE_URL=http://localhost:8000
CORE_RAG_CHAT_PATH=/api/v1/chat
CORE_RAG_CLEAR_PATH_TEMPLATE=/api/v1/chat/clear/{user_id}
CORE_RAG_TIMEOUT_MS=120000
CORE_RAG_RETRY_COUNT=1

# Slash command behavior
DISCORD_PREFIX=c!
DISCORD_ENABLE_PREFIX=true
DISCORD_COMMAND_NAME_ASK=ask
DISCORD_COMMAND_NAME_CLEAR=clear
DISCORD_RATE_LIMIT_WINDOW_MS=15000
DISCORD_RATE_LIMIT_MAX_REQUESTS=5
DISCORD_REPLY_MAX_CHARS=1900