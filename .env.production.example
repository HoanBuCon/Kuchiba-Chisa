# ─────────────────────────────────────────────────────────────────────────────
# Chisa — production environment template (single VPS, Docker Compose + Caddy)
#
#   cp .env.production.example .env && chmod 600 .env
#
# Placeholders only. Real values live ONLY in the VPS .env / secret files and are
# never committed. Every "replace_" value is rejected by the production settings
# validator, so a forgotten secret stops startup instead of running insecurely.
# Generate secrets with:  openssl rand -base64 48
# See docs/DEPLOYMENT_RUNBOOK.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
WEB_CONCURRENCY=2
SECRET_KEY=replace_with_openssl_rand_base64_48

# ── Public edge (Caddy) ─────────────────────────────────────────
CHISA_DOMAIN=chisa.example.com
CHISA_ACME_EMAIL=ops@example.com
PUBLIC_APP_URL=https://chisa.example.com
# Only the Caddy container (fixed address on chisa_edge) may set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=172.28.0.10/32

# ── Data services (passwords are Docker secret files, not env values) ─
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
REDIS_PASSWORD_FILE=./secrets/redis_password
# Required by settings validation; the app service overrides it at startup with a
# URL built from the postgres_password secret.
DATABASE_URL=postgresql+asyncpg://chisa:from_docker_secret@postgres:5432/chisa_db
REDIS_USERNAME=chisa
QDRANT_API_KEY=replace_with_openssl_rand_base64_32
QDRANT_EMBEDDING_DIM=384
INGESTION_ALLOWED_SOURCE_HOSTS=wutheringwaves.fandom.com

# ── JWT / service identity ──────────────────────────────────────
JWT_SECRET=replace_with_openssl_rand_base64_48
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=kuchiba-chisa
JWT_AUDIENCE=kuchiba-chisa-api
# Must differ from JWT_SECRET. The Discord bot uses the same value below.
DISCORD_WORKLOAD_JWT_SECRET=replace_with_a_different_openssl_rand_base64_48
DISCORD_WORKLOAD_JWT_ISSUER=kuchiba-chisa-discord

# ── User accounts ───────────────────────────────────────────────
ACCOUNT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
AUTH_COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_LOGIN_PER_EMAIL_PER_MINUTE=5
ANONYMOUS_SESSION_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=60

# ── Google sign-in (optional; leave all three empty to disable) ─
# Redirect URI must exactly match the one registered in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://chisa.example.com/api/v1/auth/google/callback

# ── LLM provider ────────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_ENABLED_PROVIDERS=deepseek
LLM_FALLBACK_PROVIDERS=
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEP_THINKING=true

# ── Embeddings / reranker (evaluated configuration, RAG-05) ─────
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_PROVIDER=jina
RERANKER_API_MODEL=jina-reranker-v3.5
RERANKER_API_MAX_DOCUMENTS=15
JINA_API_KEY=replace_with_jina_api_key
RERANKER_TIMEOUT_SECONDS=1.5

# ── Web search ──────────────────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=
ENABLE_PAID_SEARCH=false
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_TIMEOUT_SECONDS=3.5

# ── Logging / telemetry ─────────────────────────────────────────
# stdout only (Docker rotates it); compose also forces this for app/worker.
APP_LOG_FILE=
LOG_UNSAFE_CONTENT_DEBUG=false
OTEL_ENABLED=false

# ── Workers ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=1

# ── Discord bot ─────────────────────────────────────────────────
NODE_ENV=production
DISCORD_TOKEN=replace_with_discord_bot_token
DISCORD_CLIENT_ID=replace_with_discord_application_id
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
# Same value as DISCORD_WORKLOAD_JWT_SECRET.
CORE_RAG_WORKLOAD_JWT_SECRET=replace_with_the_same_value_as_DISCORD_WORKLOAD_JWT_SECRET
# Role IDs (not names) allowed to moderate besides Administrator/Manage Server.
DISCORD_MODERATOR_ROLE_IDS=
