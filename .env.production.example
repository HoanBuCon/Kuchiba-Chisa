# ─────────────────────────────────────────────────────────────────────────────
# Chisa — production environment template (single VPS, Docker Compose + Caddy)
#
#   cp .env.production.example .env && chmod 600 .env
#
# Placeholders only. Real values live ONLY in the VPS .env / secret files and are
# never committed. Every "replace_" value is rejected by the production settings
# validator, so a forgotten secret stops startup instead of running insecurely.
# Generate secrets with:  openssl rand -base64 48
# See docs/DEPLOYMENT_RUNBOOK.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
WEB_CONCURRENCY=2
SECRET_KEY=replace_with_openssl_rand_base64_48

# ── Public edge (Caddy) ─────────────────────────────────────────
CHISA_DOMAIN=chisa.example.com
CHISA_ACME_EMAIL=ops@example.com
PUBLIC_APP_URL=https://chisa.example.com
# Only the Caddy container (fixed address on chisa_edge) may set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=172.28.0.10/32

# ── Data services (passwords are Docker secret files, not env values) ─
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
REDIS_PASSWORD_FILE=./secrets/redis_password
# Required by settings validation; the app service overrides it at startup with a
# URL built from the postgres_password secret.
DATABASE_URL=postgresql+asyncpg://chisa:from_docker_secret@postgres:5432/chisa_db
REDIS_USERNAME=chisa
QDRANT_API_KEY=replace_with_openssl_rand_base64_32
QDRANT_EMBEDDING_DIM=384
INGESTION_ALLOWED_SOURCE_HOSTS=wutheringwaves.fandom.com

# ── JWT / service identity ──────────────────────────────────────
JWT_SECRET=replace_with_openssl_rand_base64_48
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=kuchiba-chisa
JWT_AUDIENCE=kuchiba-chisa-api
# Must differ from JWT_SECRET. The Discord bot uses the same value below.
DISCORD_WORKLOAD_JWT_SECRET=replace_with_a_different_openssl_rand_base64_48
DISCORD_WORKLOAD_JWT_ISSUER=kuchiba-chisa-discord

# ── User accounts ───────────────────────────────────────────────
ACCOUNT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
AUTH_COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_LOGIN_PER_EMAIL_PER_MINUTE=5
ANONYMOUS_SESSION_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=60

# ── Google sign-in (optional; leave all three empty to disable) ─
# Redirect URI must exactly match the one registered in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://chisa.example.com/api/v1/auth/google/callback

# ── LLM provider ────────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_ENABLED_PROVIDERS=deepseek
LLM_FALLBACK_PROVIDERS=
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEP_THINKING=true

# ── Embeddings / reranker (evaluated configuration, RAG-05) ─────
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Compose points app/worker at the inference service; a local reranker model is optional.
INFERENCE_RERANKER_MODEL=
RERANKER_PROVIDER=jina
RERANKER_API_MODEL=jina-reranker-v3.5
RERANKER_API_MAX_DOCUMENTS=15
JINA_API_KEY=replace_with_jina_api_key
RERANKER_TIMEOUT_SECONDS=1.5

# ── Web search ──────────────────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=
ENABLE_PAID_SEARCH=false
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_TIMEOUT_SECONDS=3.5

# ── Logging / telemetry ─────────────────────────────────────────
# stdout only (Docker rotates it); compose also forces this for app/worker.
APP_LOG_FILE=
LOG_UNSAFE_CONTENT_DEBUG=false
# docker-compose.yml enables OTEL for app/worker and points them at the local collector.
# The collector forwards to a hosted OTLP backend (Monitoring M0, SRS v2 §13.3).
MONITORING_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# Full header value, e.g. "Basic <base64(instance_id:token)>". Keep it in the VPS secret config.
MONITORING_OTLP_AUTHORIZATION=
# Dead-man heartbeats (MON-033): leave empty to disable.
WORKER_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=

# ── Workers ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=1

# ── Discord bot ─────────────────────────────────────────────────
NODE_ENV=production
DISCORD_TOKEN=replace_with_discord_bot_token
DISCORD_CLIENT_ID=replace_with_discord_application_id
DISCORD_GUILD_ID=
# Public Bot beta: the bot answers DMs and channels configured with /setup in any
# guild. There is intentionally no guild/channel allowlist (DISCORD_ALLOWED_CHANNEL_IDS
# is not read by the bot). Cost is bounded by the Discord quota pool and per-guild quota.
# Same value as DISCORD_WORKLOAD_JWT_SECRET.
CORE_RAG_WORKLOAD_JWT_SECRET=replace_with_the_same_value_as_DISCORD_WORKLOAD_JWT_SECRET
# Role IDs (not names) allowed to moderate besides Administrator/Manage Server.
DISCORD_MODERATOR_ROLE_IDS=

# ── Account e-mail (verification + password reset) via SMTP ─────
# Any transactional provider's SMTP relay (Resend, Brevo, Amazon SES, Postmark,
# Mailgun, ...). Empty SMTP_HOST disables e-mail and with it password sign-up,
# verification resend and password reset (Google sign-in and anonymous chat still work).
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
# starttls (port 587) or ssl (port 465). TLS certificates are always verified.
SMTP_SECURITY=starttls
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
# Sender on a domain with SPF + DKIM (+ DMARC) configured at the provider.
SMTP_FROM=Chisa <no-reply@chisa.example.com>
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# Per account and purpose: minimum gap between e-mails and max per 24 hours.
ACCOUNT_EMAIL_COOLDOWN_SECONDS=60
ACCOUNT_EMAIL_DAILY_LIMIT=5
# Application-wide account e-mails per UTC day (Redis; fail-closed).
EMAIL_DAILY_GLOBAL_LIMIT=300

# ── LLM cost quotas (per UTC day, Redis, fail-closed) ───────────
# Charged once per chat request. Independent pools: an abused surface cannot
# exhaust the others. Per-IP applies to anonymous web only (Discord shares the bot IP).
CHAT_QUOTA_ENABLED=true
CHAT_MESSAGE_RATE_LIMIT_PER_MINUTE=10
QUOTA_WEB_ANON_PER_SUBJECT_DAILY=30
QUOTA_WEB_ANON_PER_IP_DAILY=100
QUOTA_WEB_ACCOUNT_PER_SUBJECT_DAILY=150
QUOTA_DISCORD_PER_SUBJECT_DAILY=50
QUOTA_DISCORD_PER_GUILD_DAILY=500
QUOTA_POOL_WEB_ANON_DAILY=3000
QUOTA_POOL_WEB_ACCOUNT_DAILY=3000
QUOTA_POOL_DISCORD_DAILY=3000
